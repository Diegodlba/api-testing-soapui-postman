                  "pm.test(\"Todos los comentarios tienen postId = 9\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    jsonData.forEach(function (comentario) {",
                  "        pm.expect(comentario.postId).to.eql(9);",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"Los ids devueltos son los esperados (41-45)\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    const ids = jsonData.map(function (c) { return c.id; });",
                  "    pm.expect(ids).to.eql([41, 42, 43, 44, 45]);",
                  "});"
